{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --no-audit --no-fund --no-package-lock",
  "buildCommand": "npm run build:website && npm run check:website",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/editorial",
      "destination": "/",
      "permanent": true
    }
  ],
  "redirects": [
    { "source": "/arcade/bill-dodgers", "destination": "/arcade/bill-dodgers/", "permanent": false },
    { "source": "/arcade/bill-dodgers/([1-6]-[1-7S])", "destination": "/arcade/bill-dodgers/$1/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/arcade/bill-dodgers/(.*)", "destination": "https://bill-dodgers.vercel.app/$1" }
  ]
}
