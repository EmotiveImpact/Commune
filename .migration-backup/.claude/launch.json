{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-review",
      "runtimeExecutable": "/usr/bin/tail",
      "runtimeArgs": ["-f", "/dev/null"],
      "port": 5180
    },
    {
      "name": "landing",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@commune/landing", "dev"],
      "port": 3001
    },
    {
      "name": "mobile",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@commune/mobile", "dev"],
      "port": 8081
    },
    {
      "name": "mobile-v2",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@commune/mobile-v2", "dev", "--", "--port", "8082"],
      "port": 8082
    },
    {
      "name": "supabase",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["db:start"],
      "port": 54321
    },
    {
      "name": "all (turbo)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 5173
    },
    {
      "name": "design-mocks",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "5600", "--directory", "/tmp/commune-design-mocks", "--bind", "127.0.0.1"],
      "port": 5600
    }
  ]
}
