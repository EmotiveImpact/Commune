{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "strictFunctionTypes": true,
    "noUnusedLocals": true,
    "paths": {
      "@commune/core": ["../../packages/core/src/index.ts"]
    }
  },
  "include": ["src"]
}
