# Production/preview builds use the matching URLs from the SAME Neon branch.
# These HTTPS endpoints are public identifiers, not Postgres connection strings.
# Never put DATABASE_URL, an API key, or a service role in a VITE_* variable.
VITE_NEON_AUTH_URL=https://ep-example.neonauth.c-2.us-east-2.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://ep-example.apirest.c-2.us-east-2.aws.neon.tech/neondb/rest/v1
VITE_REMINDER_FUNCTION_URL=https://br-example-reminders.compute.example.us-east-2.aws.neon.tech

# Address suggestions under the commune address box (Google Places, the new
# Places API). Leave unset and the box is plain text. This is the one browser
# key that may go here: Google's browser keys are visible to anyone by design,
# so restrict it in Google Cloud to the Places API (New) and to the app's
# website addresses, and set a daily quota.
# VITE_GOOGLE_PLACES_KEY=
