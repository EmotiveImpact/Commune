# Production/preview builds use the matching URLs from the SAME Neon branch.
# These HTTPS endpoints are public identifiers, not Postgres connection strings.
# Never put DATABASE_URL, an API key, or a service role in a VITE_* variable.
VITE_NEON_AUTH_URL=https://ep-example.neonauth.c-2.us-east-2.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://ep-example.apirest.c-2.us-east-2.aws.neon.tech/neondb/rest/v1
